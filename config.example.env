# Optional: pass an explicit file with VEXUM_ENV_FILE; do not commit real credentials.
VEXUM_CLUSTER=mainnet-beta
VEXUM_HOME=
VEXUM_SOLANA_RPC_URL=
VEXUM_RPC_FALLBACKS=
HELIUS_RPC_URL=
HELIUS_API_KEY=
SOLSCAN_API_KEY=
PINATA_JWT=
JUPITER_API_KEY=
VEXUM_IPFS_GATEWAY=https://ipfs.io/ipfs/
VEXUM_HYPERFRAMES_BIN=
# Prefer the masked passphrase prompt. Noninteractive callers may supply these securely.
VEXUM_PASSPHRASE=
VEXUM_EXPORT_PASSPHRASE=
# Set to 1 to prohibit all real signing/submission.
VEXUM_NO_BROADCAST=1
