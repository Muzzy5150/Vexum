{
  "name": "vexum-cli",
  "version": "0.2.0-dev.1",
  "private": true,
  "type": "module",
  "bin": {
    "vexum": "./bin/vexum.js"
  },
  "scripts": {
    "vexum": "tsx src/vexum.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "test": "tsx --import ./test/no-network.ts --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "lint": "eslint src test tools bin build.mjs",
    "prepack": "npm run build",
    "test:terminal": "python3 test/terminal_interaction.py",
    "test:install": "node test/clean-install.mjs",
    "test:validator": "tsx test/validator/simulation.ts",
    "verify:mainnet": "tsx tools/verify-mainnet.ts",
    "test:smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "1.6.0",
    "@pump-fun/pump-sdk": "4.3.1",
    "@solana/spl-token": "0.4.15",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/web3.js": "1.99.0",
    "@types/bn.js": "5.2.0",
    "@types/node": "^22.18.0",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "commander": "14.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "punycode": "2.3.1",
    "tsx": "4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "zod": "4.6.7",
    "bigint-buffer": "file:vendor/bigint-buffer-safe"
  },
  "description": "VEXUM Solana Mainnet CLI \u2014 Developer Preview; funded execution unverified",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist/vexum.js",
    "dist/bundle-manifest.json",
    "dist/THIRD_PARTY_NOTICES.txt",
    "bin",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "docs",
    "config.example.env",
    ".env.example"
  ],
  "overrides": {
    "toml": "5.0.1",
    "uuid": "11.1.1",
    "jayson": "5.0.0",
    "bigint-buffer": "$bigint-buffer",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "dotenv": "17.2.3"
  },
  "license": "MIT"
}
