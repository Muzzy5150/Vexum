#!/usr/bin/env sh
set -eu
VEXUM_SOURCE="$0"
while [ -L "$VEXUM_SOURCE" ]; do
  VEXUM_DIR=$(CDPATH= cd -- "$(dirname -- "$VEXUM_SOURCE")" && pwd)
  VEXUM_LINK=$(readlink "$VEXUM_SOURCE")
  case "$VEXUM_LINK" in /*) VEXUM_SOURCE="$VEXUM_LINK" ;; *) VEXUM_SOURCE="$VEXUM_DIR/$VEXUM_LINK" ;; esac
done
VEXUM_ROOT=$(CDPATH= cd -- "$(dirname -- "$VEXUM_SOURCE")" && pwd)
if [ ! -f "$VEXUM_ROOT/dist/vexum.js" ]; then
  echo 'Build the CLI first: npm ci --ignore-scripts && npm run build' >&2
  exit 1
fi
exec node "$VEXUM_ROOT/bin/vexum.js" "$@"
